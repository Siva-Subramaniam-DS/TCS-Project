# Copy to .env and fill in what you have.
# The app runs without a Gemini key (local explainer) and without PostgreSQL (SQLite).

GEMINI_API_KEY=
JWT_SECRET=change-me-impactpulse-demo
# Uncomment for a local PostgreSQL. Docker Compose sets this itself.
# DATABASE_URL=postgresql://impact:impact@localhost:5432/impactpulse
DATA_DIR=
